#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="/etc/dcvm-install.conf"
if [ -f "$CONFIG_FILE" ]; then
  source "$CONFIG_FILE"
  LIB_DIR="${DCVM_LIB_DIR:-/usr/local/lib/dcvm}"
else
  LIB_DIR="$SCRIPT_DIR/lib"
fi
if [ ! -f "$LIB_DIR/utils/common.sh" ]; then
  echo "error: dcvm is not installed. Please run the installer first." >&2
  echo "Visit: https://github.com/metharda/dcvm" >&2
  exit 1
fi
source "$LIB_DIR/utils/common.sh"

wants_help() {
  local a
  for a in "$@"; do
    case "$a" in -h | --help) return 0 ;; esac
  done
  return 1
}

# A help flag anywhere shows only help: other arguments must never run an action.
DCVM_HELP=false
case "${1:-}" in
"" | help | -h | --help | version | -v | --version | ssh | exec | cp) ;;
*)
  if wants_help "${@:2}"; then
    DCVM_HELP=true
    case "$1:${2:-}" in
    network:ports | network:dhcp | network:vnc) set -- network "$2" --help ;;
    *) set -- "$1" --help ;;
    esac
  fi
  ;;
esac

if [ "$(id -u)" -ne 0 ] && [ "$DCVM_HELP" = false ]; then
  case "${1:-}" in
  "" | help | -h | --help | version | -v | --version | ssh | exec | cp) ;;
  *) exec python3 -I -S "$LIB_DIR/server/dcvm-client.py" "$@" ;;
  esac
fi

show_version() {
  echo "dcvm - a VM manager"
  echo "Version: 0.9.10"
  echo "https://github.com/metharda/dcvm"
}

show_usage() {
  ui_help <<EOF
dcvm - KVM virtual machines from cloud images, on one host

Usage: dcvm <command> [args]       dcvm <command> --help for its options

VMs:
  create <name> [options]       Create a VM from a cloud image (or an ISO with -o)
  create-iso <name> --iso <f>   Create a VM that boots an installer ISO
  list                          VMs with state, IP, vCPU and memory
  status                        The same, plus the network and port forwards
  start | stop | restart [vm]   One VM, or every dcvm VM without a name
  console [vm]                  Serial console of a VM; without a name, access hints
  delete <vm> | --all           Delete a VM with its disk, leases and forwards
  info <vm> [--json]            State, IP, login user, owner of one VM
  ssh | exec | cp               Use a VM over SSH with your key (dcvm ssh --help)
  protect | unprotect <vm>      Refuse delete and restore until unprotected

Network:
  network                       Network, DHCP leases, static IPs and port forwards
  network ports <command>       Forward host ports to VMs: setup, show, test, apply, clear
  network dhcp <command>        DHCP leases: show, clear, cleanup, renew
  network vnc <action> <vm>     VNC on a VM: enable, disable, status

Backups and images:
  backup <command>              create, list, restore, delete, export, import
  template <command>            Cloud images: status, list, download, verify
  storage                       Disk usage inside running VMs

System:
  self-update [--check]         Update dcvm from GitHub (--revert goes back)
  doctor [--fix]                Check (and repair) the base images of VMs and backups
  fix-lock <vm> | --all         Clear stale disk locks when a VM will not start
  user add|remove|list          Who may use dcvm without root (admins)
  owner <vm> <user>             Hand a VM to another user (admins)
  whoami                        Your dcvm user and role
  uninstall                     Remove dcvm, its VMs and data
  version                       Show the version

Examples:
  dcvm create web -f -p "\$VM_PASSWORD"
  dcvm list
  dcvm network ports setup
  dcvm backup create web

Docs: https://github.com/metharda/dcvm
EOF
}

route_command() {
  local command="$1"
  shift
  case "$command" in
  create)
    exec "$LIB_DIR/core/create-vm.sh" "$@"
    ;;
  create-iso)
    exec "$LIB_DIR/core/custom-iso.sh" "$@"
    ;;
  delete)
    exec "$LIB_DIR/core/delete-vm.sh" "$@"
    ;;
  list | status | start | stop | restart | console)
    exec "$LIB_DIR/core/vm-manager.sh" "$command" "$@"
    ;;
  network)
    exec "$LIB_DIR/network/network-manager.sh" "$@"
    ;;
  backup)
    if [ $# -eq 0 ] || [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
      exec "$LIB_DIR/storage/backup.sh" --help
    else
      exec "$LIB_DIR/storage/backup.sh" "$@"
    fi
    ;;
  restore)
    exec "$LIB_DIR/storage/backup.sh" restore "$@"
    ;;
  storage | storage-cleanup)
    exec "$LIB_DIR/storage/storage-manager.sh" "$command" "$@"
    ;;
  template | mirror)
    exec "$LIB_DIR/utils/mirror-manager.sh" "$@"
    ;;
  fix-lock)
    exec "$LIB_DIR/utils/fix-lock.sh" "$@"
    ;;
  info | whoami | protect | unprotect | reap | user | owner)
    exec "$LIB_DIR/core/access.sh" "$command" "$@"
    ;;
  ssh | exec | cp)
    exec "$LIB_DIR/core/connect.sh" "$command" "$@"
    ;;
  doctor)
    exec "$LIB_DIR/utils/doctor.sh" "$@"
    ;;
  self-update | update)
    exec "$LIB_DIR/installation/self-update.sh" "$@"
    ;;
  uninstall)
    exec "$LIB_DIR/installation/uninstall-dcvm.sh" "$@"
    ;;
  version | -v | --version)
    show_version
    ;;
  help | -h | --help)
    if [ "${1:-}" = agents ]; then
      cat "$LIB_DIR/agents.md"
    else
      show_usage
    fi
    ;;
  *)
    print_error "Unknown command: $command"
    echo ""
    show_usage
    exit 1
    ;;
  esac
}

main() {
  if [ $# -eq 0 ]; then
    show_usage
    exit 0
  fi

  local command="$1"
  shift

  route_command "$command" "$@"
}
main "$@"
